<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RDSMonitor.Web</RootNamespace>
    <UserSecretsId>rdsmonitor-web-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core + SQLite (V1). Para migrar ao SQL Server, adicionar
         Microsoft.EntityFrameworkCore.SqlServer e ajustar Program.cs. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- PasswordHasher<T> já está incluído no Microsoft.NET.Sdk.Web — sem pacote extra necessário -->
  </ItemGroup>

</Project>
