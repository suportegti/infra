<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RDSManager</title>
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg?v=@VersaoCss" />
    <link rel="apple-touch-icon" href="favicon.svg" />
    <script>
        // Aplica o tema salvo antes da primeira renderização, para não piscar
        // um tema errado por uma fração de segundo (FOUC).
        (function () {
            var salvo = null;
            try { salvo = localStorage.getItem('rdsmonitor-theme'); } catch (e) { }
            document.documentElement.setAttribute('data-theme', salvo === 'light' ? 'light' : 'dark');
        })();
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="css/site.css?v=@VersaoCss" />
    <HeadOutlet />
</head>
<body>
    <Routes />

    @* Aviso de conexão das telas interativas. O Blazor troca as classes
       components-reconnect-show / -failed / -rejected; o js/reconexao.js
       reconecta ou recarrega a página sozinho, sem precisar de F5. *@
    <div id="components-reconnect-modal" class="rds-reconexao" role="status" aria-live="polite">
        <div class="rds-reconexao-faixa">
            <i class="fa-solid fa-plug-circle-exclamation"></i>
            <span class="rds-reconexao-show">
                Conexão com o servidor perdida. Reconectando…
                <small>(tentativa <span id="components-reconnect-current-attempt"></span> de <span id="components-reconnect-max-retries"></span>)</small>
            </span>
            <span class="rds-reconexao-failed">Servidor indisponível. A página será recarregada assim que ele voltar…</span>
            <span class="rds-reconexao-rejected">Atualizando a página…</span>
            <button type="button" class="rds-reconexao-btn" onclick="location.reload()">Recarregar agora</button>
        </div>
    </div>

    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="js/reconexao.js?v=@VersaoJs"></script>
    <script src="js/site.js?v=@VersaoJs"></script>
</body>
</html>

@code {
    [Inject] private IWebHostEnvironment Env { get; set; } = null!;

    // Muda quando o site.css muda, para o navegador não usar a versão antiga em cache após uma atualização.
    private static string? versaoCss;
    private string VersaoCss => versaoCss ??=
        File.GetLastWriteTimeUtc(Path.Combine(Env.WebRootPath, "css", "site.css")).Ticks.ToString("x");

    private static string? versaoJs;
    private string VersaoJs => versaoJs ??=
        Directory.GetFiles(Path.Combine(Env.WebRootPath, "js"), "*.js")
                 .Max(f => File.GetLastWriteTimeUtc(f)).Ticks.ToString("x");
}
