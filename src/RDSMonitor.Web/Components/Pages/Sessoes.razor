@page "/sessoes"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissoes.SessoesVer)]
@inject IServerService ServerService
@inject ICommandService CommandService
@inject IPermissaoService PermissaoService
@implements IDisposable

<PageTitle>Sessões · RDSManager</PageTitle>

<ConfirmDialog @ref="confirmacao" />

@if (msgAlvo is { } alvoMsg)
{
    <div class="rds-modal-backdrop" @onclick="FecharMensagem">
        <div class="rds-modal" role="dialog" aria-modal="true" aria-labelledby="msg-titulo"
             @onclick:stopPropagation @onkeydown="TeclaMensagem">
            <div class="rds-modal-header">
                <span class="rds-modal-icon"><i class="fa-solid fa-message"></i></span>
                <h2 id="msg-titulo">Enviar mensagem</h2>
            </div>
            <p class="rds-modal-msg">A mensagem aparece em uma janela na tela do usuário.</p>
            <dl class="rds-modal-details">
                <dt>Usuário</dt><dd>@alvoMsg.Sess.Username</dd>
                <dt>Sessão</dt><dd>@alvoMsg.Sess.RdsSessionId</dd>
                <dt>Servidor</dt><dd>@alvoMsg.Sv.Name</dd>
            </dl>
            <textarea class="rds-modal-text" rows="4" maxlength="500" autofocus
                      placeholder="Ex.: O servidor será reiniciado às 19h. Salve seus arquivos."
                      @bind="msgTexto" @bind:event="oninput"></textarea>
            <div class="rds-modal-actions">
                <button type="button" class="btn-pill" @onclick="FecharMensagem">Cancelar</button>
                <button type="button" class="btn-pill primary" disabled="@string.IsNullOrWhiteSpace(msgTexto)" @onclick="EnviarMensagemAsync">
                    <i class="fa-solid fa-paper-plane"></i> Enviar
                </button>
            </div>
        </div>
    </div>
}

<div class="dash-header">
    <h1>Sessões</h1>
    <p>Usuários conectados nos servidores RDS e os processos de cada um.</p>
</div>

<div class="toolbar">
    <div class="toolbar-search process-search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text"
               placeholder="@(PesquisaEmProcessos ? "Pesquisar usuário, máquina, IP, processo ou PID (ex: joao, chrome, 4532)" : "Pesquisar usuário, máquina ou IP (ex: joao, NB-FIN01, 10.0.1.20)")"
               aria-label="Pesquisar sessões"
               value="@busca"
               @oninput="AoDigitarAsync" />
        @if (BuscaAtiva)
        {
            <button class="search-clear" title="Limpar pesquisa" aria-label="Limpar pesquisa" @onclick="LimparBuscaAsync">
                <i class="fa-solid fa-xmark" style="position:static;transform:none;"></i>
            </button>
        }
    </div>
    <div class="toolbar-search" style="flex:0 1 200px;min-width:170px;">
        <i class="fa-solid fa-hard-drive"></i>
        <select @bind="servidorSelecionadoId" @bind:after="AtualizarAsync" class="toolbar-select" aria-label="Filtrar por servidor">
            <option value="0">Todos os servidores</option>
            @foreach (var sv in servidores.Where(s => string.IsNullOrEmpty(clienteSelecionado) || s.Cliente == clienteSelecionado))
            {
                <option value="@sv.Id">@(sv.DisplayName ?? sv.Name)</option>
            }
        </select>
    </div>
    @if (clientes.Count > 0)
    {
    <div class="toolbar-search" style="flex:0 1 190px;min-width:160px;">
        <i class="fa-solid fa-building"></i>
        <select @bind="clienteSelecionado" @bind:after="AoTrocarClienteAsync" class="toolbar-select" aria-label="Filtrar por cliente">
            <option value="">Todos os clientes</option>
            @foreach (var c in clientes)
            {
                <option value="@c">@c</option>
            }
        </select>
    </div>
    }
    <div class="toolbar-search" style="flex:0 1 180px;min-width:150px;">
        <i class="fa-solid fa-plug"></i>
        <select @bind="estadoSelecionado" class="toolbar-select" aria-label="Filtrar por estado da conexão">
            <option value="">Todas as conexões</option>
            <option value="ativas">Ativas</option>
            <option value="desconectadas">Desconectadas</option>
        </select>
    </div>
    @if (podeVerProcessos)
    {
    <label class="toolbar-check" title="Na pesquisa, procura também nos processos e já abre a lista de processos de cada sessão encontrada.">
        <input type="checkbox" @bind="mostrarProcessos" @bind:after="AoMudarMostrarProcessosAsync" /> Mostrar processos
    </label>
    <label class="toolbar-check" title="Processos do Windows (csrss, dwm, svchost...) e de contas de sistema. Não podem ser derrubados.">
        <input type="checkbox" @bind="mostrarSistema" /> Processos do sistema
    </label>
    }
    <div class="toolbar-actions">
        <button class="btn-pill" @onclick="AtualizarAsync">
            <i class="fa-solid fa-rotate"></i> Atualizar
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="login-alert @(erroMensagem ? "" : "login-alert-success")" role="alert">
        @mensagem
    </div>
}

@{
    var sessoes = ServidoresFiltrados()
        .SelectMany(s => s.Sessions.OrderBy(x => x.Username).Select(sess => (sv: s, sess)))
        .Where(x => estadoSelecionado switch
        {
            "ativas"        => x.sess.State != SessionState.Disconnected,
            "desconectadas" => x.sess.State == SessionState.Disconnected,
            _               => true,
        })
        .ToList();

    // Pesquisa: usuário, máquina, IP ou servidor; com "Mostrar processos", também processo/PID.
    if (BuscaAtiva)
        sessoes = sessoes.Where(x => SessaoCasa(x.sv, x.sess)
                                  || (PesquisaEmProcessos && ProcessosVisiveis(x.sv.Id, x.sess.RdsSessionId, filtrarPelaBusca: true).Count > 0)).ToList();

    var colunas = PodeAgirNaSessao ? 11 : 10;
}

@if (BuscaAtiva)
{
    <p class="search-summary" role="status">
        @if (sessoes.Count == 0)
        {
            <span>Nenhuma sessão encontrada para <strong>"@busca"</strong>@(PesquisaEmProcessos && !mostrarSistema ? " (processos do sistema ocultos)" : "").</span>
        }
        else if (PesquisaEmProcessos)
        {
            var totalProcs = sessoes.Sum(x => ProcessosDaLinha(x.sv, x.sess).Count);
            <span><strong>@sessoes.Count</strong> sessão(ões) e <strong>@totalProcs</strong> processo(s) para <strong>"@busca"</strong>.</span>
        }
        else
        {
            <span><strong>@sessoes.Count</strong> sessão(ões) para <strong>"@busca"</strong>@(podeVerProcessos ? " — clique na seta para ver os processos" : "").</span>
        }
    </p>
}
else if (sessoes.Count > 0)
{
    <p class="search-summary" role="status">
        <span><strong>@sessoes.Count</strong> sessão(ões): @sessoes.Count(x => x.sess.State != SessionState.Disconnected) ativa(s), @sessoes.Count(x => x.sess.State == SessionState.Disconnected) desconectada(s).</span>
    </p>
}

@if (!sessoes.Any())
{
    @if (!BuscaAtiva)
    {
        <p class="dash-note">
            @(estadoSelecionado == "desconectadas" ? "Nenhuma sessão desconectada no momento." : "Nenhuma sessão no momento.")
            @if (!servidores.Any(s => s.IsOnline))
            {
                <span>Instale o agente nos servidores para ver dados em tempo real.</span>
            }
        </p>
    }
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th></th>
                <th>Servidor</th>
                <th>Usuário</th>
                <th>Sessão</th>
                <th>Origem</th>
                <th>Estado</th>
                <th>CPU</th>
                <th>Memória</th>
                <th>Login</th>
                <th>Ociosidade</th>
                @if (PodeAgirNaSessao) { <th>Ações</th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var (sv, sess) in sessoes)
            {
                var chave     = (sv.Id, sess.RdsSessionId);
                var expandida = ExpandeAutomatico || expandidas.Contains(chave);
                <tr class="@(expandida ? "row-expanded" : "")">
                    <td>
                        @if (!ExpandeAutomatico && podeVerProcessos)
                        {
                            <button class="btn-expand" @onclick="() => AlternarProcessosAsync(sv.Id, sess.RdsSessionId)"
                                    title="@(expandida ? "Ocultar processos" : "Ver processos")"
                                    aria-expanded="@(expandida ? "true" : "false")">
                                <i class="fa-solid @(expandida ? "fa-chevron-down" : "fa-chevron-right")"></i>
                            </button>
                        }
                    </td>
                    <td class="mono">
                        @sv.Name
                        @if (sv.Cliente is not null)
                        {
                            <span class="sub-label">@sv.Cliente</span>
                        }
                    </td>
                    <td>
                        @Realcar(sess.Username)
                        @if (EhSimulada(sess))
                        {
                            <span class="badge-sim" title="Sessão fictícia gerada pelo modo de simulação do agente">simulada</span>
                        }
                    </td>
                    <td class="mono">
                        @sess.RdsSessionId
                        @if (sess.SessionName is not null)
                        {
                            <span>(@sess.SessionName)</span>
                        }
                    </td>
                    <td>
                        @if (sess.ClientName is null && sess.ClientIp is null)
                        {
                            <span class="sub-label">—</span>
                        }
                        else
                        {
                            <span class="mono">@Realcar(sess.ClientName ?? "")</span>
                            @if (sess.ClientIp is not null)
                            {
                                <span class="sub-label mono">@Realcar(sess.ClientIp)</span>
                            }
                        }
                    </td>
                    <td>
                        <span class="status-dot @sess.State.ToString().ToLower()"></span>
                        @NomeEstado(sess.State)
                    </td>
                    <td class="mono">@sess.CpuPercent.ToString("0.#")%</td>
                    <td class="mono">@FormatarMemoria(sess.MemoryMb)</td>
                    <td class="mono">@Horario.Fmt(sess.LogonTime, "dd/MM HH:mm")</td>
                    <td class="mono">@(sess.IdleTimeMinutes == 0 ? "—" : FormatarOciosidade(sess.IdleTimeMinutes))</td>
                    @if (PodeAgirNaSessao)
                    {
                        <td class="acoes">
                            @if (podeMensagem)
                            {
                                <button class="btn-acao" @onclick="() => AbrirMensagem(sv, sess)"
                                        disabled="@(sess.State == SessionState.Disconnected)"
                                        title="@(sess.State == SessionState.Disconnected ? "Sessão desconectada: o usuário não veria a mensagem" : "Mostrar uma mensagem na tela do usuário")">
                                    <i class="fa-solid fa-message"></i> Mensagem
                                </button>
                            }
                            @if (podeDesconectar)
                            {
                                <button class="btn-acao" @onclick="() => DisconnectAsync(sv, sess)"
                                        disabled="@(sess.State == SessionState.Disconnected)"
                                        title="@(sess.State == SessionState.Disconnected ? "Sessão já está desconectada" : "Desconectar mantendo os programas abertos")">
                                    Disconnect
                                </button>
                            }
                            @if (podeLogoff)
                            {
                                <button class="btn-acao danger" @onclick="() => LogoffAsync(sv, sess)"
                                        title="Encerrar a sessão (fecha todos os programas do usuário)">
                                    Logoff
                                </button>
                            }
                        </td>
                    }
                </tr>

                @if (expandida && podeVerProcessos)
                {
                    var todos    = processos.TryGetValue(chave, out var lista) ? lista : new List<ServerProcess>();
                    var visiveis = ProcessosDaLinha(sv, sess);
                    var filtrouPorBusca = ExpandeAutomatico && !SessaoCasa(sv, sess);
                    var ocultos  = filtrouPorBusca ? 0 : todos.Count - visiveis.Count;
                    <tr class="row-detail">
                        <td colspan="@colunas">
                            @if (todos.Count == 0)
                            {
                                <p class="dash-note" style="margin:0;">
                                    Nenhum processo recebido para esta sessão ainda — aguarde o próximo heartbeat do agente.
                                </p>
                            }
                            else
                            {
                                <table class="data-table nested">
                                    <thead>
                                        <tr>
                                            <th>Processo</th>
                                            <th>PID</th>
                                            <th>Dono</th>
                                            <th>CPU</th>
                                            <th>Memória</th>
                                            @if (podeDerrubar) { <th></th> }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var proc in visiveis)
                                        {
                                            var pendente = killsPendentes.Values.Any(k => k.ServerId == sv.Id && k.Pid == proc.Pid);
                                            <tr class="@(proc.IsProtected ? "row-protected" : "")">
                                                <td>
                                                    @if (proc.IsProtected)
                                                    {
                                                        <i class="fa-solid fa-lock" title="Processo do sistema — protegido"></i>
                                                    }
                                                    @Realcar(proc.Name)
                                                </td>
                                                <td class="mono">@Realcar(proc.Pid.ToString())</td>
                                                <td>@Realcar(proc.Username ?? "—")</td>
                                                <td class="mono">@proc.CpuPercent.ToString("0.#")%</td>
                                                <td class="mono">@FormatarMemoria(proc.MemoryMb)</td>
                                                @if (podeDerrubar)
                                                {
                                                    <td class="acoes">
                                                        @if (proc.IsProtected)
                                                        {
                                                            <span class="sub-label">protegido</span>
                                                        }
                                                        else if (pendente)
                                                        {
                                                            <span class="sub-label"><i class="fa-solid fa-spinner fa-spin"></i> derrubando…</span>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn-acao danger" @onclick="() => DerrubarAsync(sv, sess, proc)">
                                                                <i class="fa-solid fa-skull-crossbones"></i> Derrubar
                                                            </button>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <p class="dash-note" style="margin:.5rem 0 0;">
                                    @visiveis.Count processo(s)
                                    @if (ocultos > 0)
                                    {
                                        <span> · @ocultos processo(s) do sistema ocultos</span>
                                    }
                                    · ordenados por CPU.
                                </p>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private ConfirmDialog confirmacao = null!;

    [SupplyParameterFromQuery(Name = "servidor")] private int?    ServidorQuery { get; set; }
    [SupplyParameterFromQuery(Name = "estado")]   private string? EstadoQuery   { get; set; }
    [SupplyParameterFromQuery(Name = "cliente")]  private string? ClienteQuery  { get; set; }

    private List<Server> servidores = new();
    private List<string> clientes   = new();
    private int     servidorSelecionadoId;
    private string  clienteSelecionado = string.Empty;
    private string  estadoSelecionado  = string.Empty;
    private bool    mostrarSistema;
    private bool    mostrarProcessos;
    private (int?, string?, string?) filtrosDaUrl;
    private System.Security.Claims.ClaimsPrincipal usuario = new();

    // Permissões do usuário (reavaliadas a cada atualização da tela)
    private bool podeVerProcessos, podeMensagem, podeDesconectar, podeLogoff, podeDerrubar;
    private bool PodeAgirNaSessao => podeMensagem || podeDesconectar || podeLogoff;

    // Mensagem
    private (Server Sv, Session Sess)? msgAlvo;
    private string msgTexto = string.Empty;
    private string? mensagem;
    private bool    erroMensagem;

    // ── Pesquisa ──────────────────────────────────────────────
    private string busca = string.Empty;
    private bool   BuscaAtiva => !string.IsNullOrWhiteSpace(busca);

    /// <summary>Pesquisa também nos processos (flag "Mostrar processos").</summary>
    private bool PesquisaEmProcessos => podeVerProcessos && mostrarProcessos;

    /// <summary>Com "Mostrar processos" marcado, a pesquisa já abre os processos das sessões encontradas.</summary>
    private bool ExpandeAutomatico => BuscaAtiva && PesquisaEmProcessos;

    // Sessões com a lista de processos aberta, e processos carregados por (servidor, sessão).
    // Durante a pesquisa são carregados os processos de todas as sessões.
    private readonly HashSet<(int ServerId, int SessionId)> expandidas = new();
    private Dictionary<(int, int), List<ServerProcess>> processos = new();

    // Comandos KillProcess enfileirados nesta tela, aguardando resultado do agente
    private readonly Dictionary<int, (int ServerId, int Pid, string Nome)> killsPendentes = new();

    private System.Timers.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        usuario = (await AuthState).User;
        AplicarFiltrosDaUrl();

        await AtualizarAsync();

        _timer = new System.Timers.Timer(5_000);
        _timer.Elapsed += async (_, _) => await InvokeAsync(async () =>
        {
            await AtualizarAsync();
            StateHasChanged();
        });
        _timer.Start();
    }

    /// <summary>
    /// Filtros vindos da URL (ex.: clique num servidor do Dashboard →
    /// /sessoes?servidor=3). Reaplicados se a URL mudar com a tela aberta.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (filtrosDaUrl == (ServidorQuery, EstadoQuery, ClienteQuery)) return;
        AplicarFiltrosDaUrl();
        if (servidores.Count > 0) await AtualizarAsync();
    }

    private void AplicarFiltrosDaUrl()
    {
        filtrosDaUrl          = (ServidorQuery, EstadoQuery, ClienteQuery);
        servidorSelecionadoId = ServidorQuery ?? 0;
        estadoSelecionado     = EstadoQuery is "ativas" or "desconectadas" ? EstadoQuery : string.Empty;
        clienteSelecionado    = ClienteQuery ?? string.Empty;
    }

    private IEnumerable<Server> ServidoresFiltrados() => servidores
        .Where(s => servidorSelecionadoId == 0 || s.Id == servidorSelecionadoId)
        .Where(s => string.IsNullOrEmpty(clienteSelecionado) || s.Cliente == clienteSelecionado);

    private async Task AoTrocarClienteAsync()
    {
        // O servidor escolhido pode não ser do novo cliente
        if (servidorSelecionadoId != 0 && !ServidoresFiltrados().Any()) servidorSelecionadoId = 0;
        await CarregarProcessosAsync();
    }

    private async Task AoMudarMostrarProcessosAsync()
    {
        if (!mostrarProcessos) expandidas.Clear();
        await CarregarProcessosAsync();
    }

    /// <summary>
    /// Após enviar um comando (logoff, disconnect, mensagem, derrubar), agenda
    /// alguns refreshes curtos para a tela mostrar o resultado assim que o agente
    /// executar e enviar o heartbeat imediato, sem esperar o ciclo normal.
    /// </summary>
    private void AtualizarEmBreve()
    {
        foreach (var atrasoMs in new[] { 2_000, 4_000, 6_500 })
        {
            var t = new System.Timers.Timer(atrasoMs) { AutoReset = false };
            t.Elapsed += async (_, _) =>
            {
                try { await InvokeAsync(async () => { await AtualizarAsync(); StateHasChanged(); }); }
                catch { /* componente pode ter sido descartado */ }
                finally { t.Dispose(); }
            };
            t.Start();
        }
    }

    private async Task CarregarPermissoesAsync()
    {
        var p = await PermissaoService.DoUsuarioAsync(usuario);
        podeVerProcessos = p.Contains(Permissoes.ProcessosVer);
        podeMensagem     = p.Contains(Permissoes.SessoesMensagem);
        podeDesconectar  = p.Contains(Permissoes.SessoesDesconectar);
        podeLogoff       = p.Contains(Permissoes.SessoesLogoff);
        podeDerrubar     = p.Contains(Permissoes.ProcessosDerrubar) && podeVerProcessos;
        if (!podeVerProcessos) { mostrarProcessos = false; expandidas.Clear(); }
    }

    private async Task AtualizarAsync()
    {
        await CarregarPermissoesAsync();
        servidores = await ServerService.GetAllWithSessionsAsync();
        clientes   = servidores.Where(s => s.Cliente is not null).Select(s => s.Cliente!)
                               .Distinct().OrderBy(c => c, StringComparer.CurrentCultureIgnoreCase).ToList();

        // Esquece sessões que encerraram
        expandidas.RemoveWhere(k => !servidores.Any(s => s.Id == k.ServerId && s.Sessions.Any(x => x.RdsSessionId == k.SessionId)));

        await CarregarProcessosAsync();
        await VerificarKillsAsync();
    }

    private async Task CarregarProcessosAsync()
    {
        var novos = new Dictionary<(int, int), List<ServerProcess>>();

        if (ExpandeAutomatico)
        {
            // Pesquisa em processos: todos os processos dos servidores visíveis, agrupados por sessão
            foreach (var sv in ServidoresFiltrados())
                foreach (var g in (await ServerService.GetProcessesAsync(sv.Id)).GroupBy(p => p.RdsSessionId))
                    novos[(sv.Id, g.Key)] = g.ToList();
        }
        else
        {
            foreach (var k in expandidas)
                novos[k] = await ServerService.GetProcessesAsync(k.ServerId, k.SessionId);
        }

        processos = novos;
    }

    /// <summary>A sessão casa com a pesquisa pelos dados dela (usuário, máquina, IP ou servidor).</summary>
    private bool SessaoCasa(Server sv, Session sess)
    {
        if (!BuscaAtiva) return true;
        var t = busca.Trim();
        return sess.Username.Contains(t, StringComparison.OrdinalIgnoreCase)
            || (sess.ClientName?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false)
            || (sess.ClientIp?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false)
            || sv.Name.Contains(t, StringComparison.OrdinalIgnoreCase)
            || (sv.DisplayName?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    /// <summary>
    /// Processos exibidos na linha aberta: se a sessão foi encontrada pelos
    /// dados dela, todos; se foi encontrada por um processo, só os que casam.
    /// </summary>
    private List<ServerProcess> ProcessosDaLinha(Server sv, Session sess)
        => ProcessosVisiveis(sv.Id, sess.RdsSessionId, filtrarPelaBusca: ExpandeAutomatico && !SessaoCasa(sv, sess));

    /// <summary>
    /// Processos de uma sessão, sem os do sistema se ocultos; com
    /// <paramref name="filtrarPelaBusca"/>, só os que casam com o termo (nome, PID ou dono).
    /// </summary>
    private List<ServerProcess> ProcessosVisiveis(int serverId, int sessionId, bool filtrarPelaBusca)
    {
        if (!processos.TryGetValue((serverId, sessionId), out var lista)) return new();

        IEnumerable<ServerProcess> q = lista;
        if (!mostrarSistema) q = q.Where(p => !p.IsProtected);

        if (filtrarPelaBusca && BuscaAtiva)
        {
            var termo = busca.Trim();
            q = q.Where(p => p.Name.Contains(termo, StringComparison.OrdinalIgnoreCase)
                          || p.Pid.ToString().StartsWith(termo, StringComparison.Ordinal)
                          || (p.Username?.Contains(termo, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return q.ToList();
    }

    private async Task AoDigitarAsync(ChangeEventArgs e)
    {
        var estavaAtiva = ExpandeAutomatico;
        busca = e.Value?.ToString() ?? string.Empty;

        // Ao entrar ou sair da pesquisa em processos recarrega do banco; enquanto
        // digita, o filtro é só em memória (SessaoCasa / ProcessosVisiveis).
        if (estavaAtiva != ExpandeAutomatico)
            await CarregarProcessosAsync();
    }

    private async Task LimparBuscaAsync()
    {
        busca = string.Empty;
        await CarregarProcessosAsync();
    }

    private async Task AlternarProcessosAsync(int serverId, int sessionId)
    {
        var k = (serverId, sessionId);
        if (!expandidas.Remove(k))
        {
            expandidas.Add(k);
            processos[k] = await ServerService.GetProcessesAsync(serverId, sessionId);
        }
    }

    /// <summary>Destaca o termo pesquisado dentro do texto.</summary>
    private RenderFragment Realcar(string texto) => builder =>
    {
        var termo = busca.Trim();
        var i = BuscaAtiva ? texto.IndexOf(termo, StringComparison.OrdinalIgnoreCase) : -1;
        if (i < 0)
        {
            builder.AddContent(0, texto);
            return;
        }
        builder.AddContent(0, texto[..i]);
        builder.OpenElement(1, "mark");
        builder.AddAttribute(2, "class", "hl");
        builder.AddContent(3, texto.Substring(i, termo.Length));
        builder.CloseElement();
        builder.AddContent(4, texto[(i + termo.Length)..]);
    };

    // ── Derrubar processo ─────────────────────────────────────

    private async Task DerrubarAsync(Server sv, Session sess, ServerProcess proc)
    {
        var ok = await confirmacao.PerguntarAsync(
            "Derrubar processo?",
            "O processo será encerrado à força. Qualquer trabalho não salvo nele será perdido.",
            "Derrubar processo",
            perigo: true,
            detalhes: new[]
            {
                ("Processo", proc.Name),
                ("PID",      proc.Pid.ToString()),
                ("Usuário",  sess.Username),
                ("Servidor", sv.Name),
            });
        if (!ok) return;

        // Nome e sessão vão junto para o agente conferir que o PID ainda é o mesmo processo.
        var cmd = await CriarComandoAsync(sv.Id, CommandType.KillProcess,
            new Dictionary<string, string>
            {
                { "Pid",         proc.Pid.ToString() },
                { "ProcessName", proc.Name },
                { "SessionId",   sess.RdsSessionId.ToString() },
            });
        if (cmd is null) return;

        killsPendentes[cmd.Id] = (sv.Id, proc.Pid, proc.Name);
        Avisar($"Comando para derrubar \"{proc.Name}\" (PID {proc.Pid}) enviado a {sv.Name}. O agente executa em alguns segundos.", erro: false);
        AtualizarEmBreve();
    }

    /// <summary>Mostra o resultado dos comandos de derrubar quando o agente responder.</summary>
    private async Task VerificarKillsAsync()
    {
        if (killsPendentes.Count == 0) return;

        foreach (var cmd in await CommandService.GetByIdsAsync(killsPendentes.Keys))
        {
            if (cmd.Status is CommandStatus.Pending or CommandStatus.Executing) continue;

            var (_, pid, nome) = killsPendentes[cmd.Id];
            killsPendentes.Remove(cmd.Id);

            if (cmd.Status == CommandStatus.Completed)
                Avisar(cmd.Output ?? $"Processo \"{nome}\" (PID {pid}) encerrado.", erro: false);
            else
                Avisar($"Não foi possível derrubar \"{nome}\" (PID {pid}): {cmd.Error ?? "erro desconhecido"}", erro: true);
        }
    }

    // ── Logoff / Disconnect ───────────────────────────────────

    private async Task LogoffAsync(Server sv, Session sess)
    {
        var ok = await confirmacao.PerguntarAsync(
            "Fazer logoff da sessão?",
            "A sessão será encerrada e todos os programas abertos pelo usuário serão fechados. Trabalho não salvo será perdido.",
            "Fazer logoff",
            perigo: true,
            detalhes: DetalhesSessao(sv, sess));
        if (!ok) return;

        await EnfileirarAsync(sv, sess, CommandType.Logoff);
    }

    private async Task DisconnectAsync(Server sv, Session sess)
    {
        var ok = await confirmacao.PerguntarAsync(
            "Desconectar a sessão?",
            "O usuário perde a conexão, mas a sessão continua aberta no servidor com os programas em execução. Ele pode reconectar e continuar de onde parou.",
            "Desconectar",
            perigo: false,
            detalhes: DetalhesSessao(sv, sess));
        if (!ok) return;

        await EnfileirarAsync(sv, sess, CommandType.Disconnect);
    }

    private static IReadOnlyList<(string, string)> DetalhesSessao(Server sv, Session sess) => new[]
    {
        ("Usuário",  sess.Username),
        ("Sessão",   sess.SessionName is null ? sess.RdsSessionId.ToString() : $"{sess.RdsSessionId} ({sess.SessionName})"),
        ("Servidor", sv.Name),
    };

    private async Task EnfileirarAsync(Server sv, Session sess, CommandType tipo)
    {
        if (await CriarComandoAsync(sv.Id, tipo,
                new Dictionary<string, string> { { "SessionId", sess.RdsSessionId.ToString() } }) is null)
            return;
        var acao = tipo == CommandType.Logoff ? "Logoff" : "Disconnect";
        Avisar($"{acao} de {sess.Username} (sessão {sess.RdsSessionId}) enviado a {sv.Name}. O agente executa em alguns segundos.", erro: false);
        AtualizarEmBreve();
    }

    // ── Mensagem ──────────────────────────────────────────────

    private void AbrirMensagem(Server sv, Session sess)
    {
        msgAlvo  = (sv, sess);
        msgTexto = string.Empty;
    }

    private void FecharMensagem() => msgAlvo = null;

    private void TeclaMensagem(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") FecharMensagem();
    }

    private async Task EnviarMensagemAsync()
    {
        if (msgAlvo is not { } alvo || string.IsNullOrWhiteSpace(msgTexto)) return;
        var texto = msgTexto.Trim();
        msgAlvo = null;

        var cmd = await CriarComandoAsync(alvo.Sv.Id, CommandType.SendMessage, new Dictionary<string, string>
        {
            { "SessionId", alvo.Sess.RdsSessionId.ToString() },
            { "Message",   texto },
            { "Title",     "Mensagem do administrador" },
        });
        if (cmd is not null)
            Avisar($"Mensagem para {alvo.Sess.Username} (sessão {alvo.Sess.RdsSessionId}) enviada a {alvo.Sv.Name}.", erro: false);
    }

    // ── Helpers ───────────────────────────────────────────────

    /// <summary>Enfileira o comando; o serviço confere a permissão e grava a auditoria.</summary>
    private async Task<Command?> CriarComandoAsync(int serverId, CommandType tipo, Dictionary<string, string> parametros)
    {
        try
        {
            return await CommandService.CreateAsync(serverId, tipo, parametros, usuario);
        }
        catch (UnauthorizedAccessException ex)
        {
            Avisar(ex.Message, erro: true);
            await CarregarPermissoesAsync();
            return null;
        }
    }

    private void Avisar(string texto, bool erro)
    {
        mensagem     = texto;
        erroMensagem = erro;
    }

    /// <summary>Sessões fictícias do modo de simulação do agente usam o nome "sim#ID".</summary>
    private static bool EhSimulada(Session s) => s.SessionName?.StartsWith("sim#", StringComparison.OrdinalIgnoreCase) == true;

    private static string NomeEstado(SessionState s) => s switch
    {
        SessionState.Active       => "Ativa",
        SessionState.Disconnected => "Desconectada",
        SessionState.Idle         => "Ociosa",
        _                         => s.ToString(),
    };

    private static string FormatarMemoria(double mb)
        => mb >= 1024 ? $"{mb / 1024:0.##} GB" : $"{mb:0} MB";

    private static string FormatarOciosidade(int minutos)
        => minutos >= 60 ? $"{minutos / 60}h {minutos % 60:D2}m" : $"{minutos} min";

    public void Dispose() => _timer?.Dispose();
}
