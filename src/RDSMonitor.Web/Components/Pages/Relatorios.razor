@page "/relatorios"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissoes.RelatoriosVer)]
@inject IRelatorioService RelatorioService

<PageTitle>Relatórios · RDSManager</PageTitle>

<div class="dash-header">
    <h1>Relatórios</h1>
    <p>Histórico e estatísticas de uso dos servidores.</p>
</div>

<h2 class="relatorio-titulo">
    <i class="fa-solid fa-clock-rotate-left"></i> Histórico de sessões
</h2>

<section class="form-panel audit-filtros">
    <FiltroPeriodo Periodo="periodo" OnAlterado="PesquisarAsync" />

    <div class="form-grid audit-grid">
        @if (clientes.Count > 0)
        {
            <label class="field-label">
                <span>Cliente</span>
                <select @bind="filtro.Cliente" @bind:after="PesquisarAsync">
                    <option value="">Todos</option>
                    @foreach (var c in clientes) { <option value="@c">@c</option> }
                </select>
            </label>
        }
        <label class="field-label">
            <span>Servidor</span>
            <select @bind="filtro.Servidor" @bind:after="PesquisarAsync">
                <option value="">Todos</option>
                @foreach (var sv in servidores) { <option value="@sv">@sv</option> }
            </select>
        </label>
        <label class="field-label">
            <span>Usuário, máquina ou IP</span>
            <input @bind="filtro.Usuario" placeholder="ex: joao, NB-FIN01, 10.0.1.20" @onkeydown="EnterAsync" />
        </label>
        <label class="field-label">
            <span>Situação</span>
            <select @bind="filtro.Situacao" @bind:after="PesquisarAsync">
                <option value="">Todas</option>
                <option value="ativas">Ainda conectadas</option>
                <option value="encerradas">Encerradas</option>
                <option value="desconexoes">Com desconexões</option>
            </select>
        </label>
    </div>

    <div class="form-actions">
        <button class="btn-pill primary" @onclick="PesquisarAsync"><i class="fa-solid fa-magnifying-glass"></i> Pesquisar</button>
        <button class="btn-pill" @onclick="LimparAsync"><i class="fa-solid fa-eraser"></i> Limpar filtros</button>
        <a class="btn-pill" href="@Url("eventos.xlsx")" download title="As mesmas linhas e colunas da tabela abaixo">
            <i class="fa-solid fa-file-excel"></i> Exportar Excel
        </a>
    </div>
</section>

<p class="dash-note relatorio-nota">
    Cada linha é um evento das sessões no período: LOGON, DESCONEXÃO, RECONEXÃO e LOGOFF, lidos pelo agente
    dos logs do Windows (eventos 21, 24, 25 e 23). Sessões registradas antes disso mostram LOGON e LOGOFF
    pelos horários de login e logoff (marcados com <i class="fa-solid fa-clock-rotate-left"></i>).
</p>

@if (!carregando && itens.Count > 0)
{
    <div class="relatorio-resumo" role="group" aria-label="Resumo do período">
        <div class="relatorio-kpi"><span>Sessões</span><strong>@resumo.Sessoes</strong></div>
        <div class="relatorio-kpi"><span>Usuários distintos</span><strong>@resumo.Usuarios</strong></div>
        <div class="relatorio-kpi"><span>Pico simultâneo</span><strong>@resumo.PicoSimultaneo</strong></div>
        <div class="relatorio-kpi"><span>Tempo total</span><strong>@Horas(resumo.TempoTotal)</strong></div>
        <div class="relatorio-kpi"><span>Tempo médio</span><strong>@Horas(resumo.TempoMedio)</strong></div>
        <div class="relatorio-kpi"><span>Desconexões</span><strong>@resumo.Desconexoes</strong></div>
        <div class="relatorio-kpi" title="Desconexões sem ação do usuário ou do administrador: queda de rede, cliente fechado, etc.">
            <span>Conexões perdidas</span><strong>@resumo.QuedasDeConexao</strong>
        </div>
        <div class="relatorio-kpi"><span>Tempo desconectado</span><strong>@Curta(resumo.TempoDesconectado)</strong></div>
    </div>
}

<div class="toolbar relatorio-opcoes">
    <label class="toolbar-check" title="Eventos 1149 (autenticação RDP) e 22 (área de trabalho carregada)">
        <input type="checkbox" @bind="incluirSecundarios" @bind:after="MontarLinhas" /> Mostrar autenticação e área de trabalho
    </label>
</div>

<p class="search-summary" role="status">
    @if (carregando)
    {
        <span><i class="fa-solid fa-spinner fa-spin"></i> Pesquisando…</span>
    }
    else
    {
        <span>
            <strong>@linhas.Count</strong> evento(s) de <strong>@itens.Count</strong> sessão(ões)@(truncado ? $" — exibindo as {filtro.Limite} sessões mais recentes; refine o período ou exporte para o Excel" : "")@(linhas.Count > LimiteTela ? $" — mostrando os {LimiteTela} primeiros; exporte para ver todos" : "").
        </span>
    }
</p>

@if (linhas.Count > 0)
{
    <table class="data-table relatorio-eventos">
        <thead>
            <tr>
                <ThOrdenavel Titulo="Data/hora" Campo="data"     Ordem="ordem" ComecaDecrescente OnAlterada="MontarLinhas" />
                <ThOrdenavel Titulo="Servidor"  Campo="servidor" Ordem="ordem" OnAlterada="MontarLinhas" />
                <ThOrdenavel Titulo="Usuário"   Campo="usuario"  Ordem="ordem" OnAlterada="MontarLinhas" />
                <ThOrdenavel Titulo="Sessão"    Campo="sessao"   Ordem="ordem" OnAlterada="MontarLinhas" />
                <ThOrdenavel Titulo="Origem"    Campo="origem"   Ordem="ordem" OnAlterada="MontarLinhas" />
                <ThOrdenavel Titulo="Duração"   Campo="duracao"  Ordem="ordem" ComecaDecrescente OnAlterada="MontarLinhas" />
                <ThOrdenavel Titulo="Status"    Campo="status"   Ordem="ordem" OnAlterada="MontarLinhas" />
                <ThOrdenavel Titulo="Detalhe"   Campo="detalhe"  Ordem="ordem" OnAlterada="MontarLinhas" />
            </tr>
        </thead>
        <tbody>
            @foreach (var l in linhas.Take(LimiteTela))
            {
                var h = l.Sessao;
                <tr class="@(l.Tipo is SessionEventType.Shell or SessionEventType.Autenticacao ? "row-secundaria" : "")">
                    <td class="mono">
                        @Horario.Fmt(l.DataHora, "dd/MM/yyyy HH:mm:ss")
                        @if (!l.Registrado)
                        {
                            <i class="fa-solid fa-clock-rotate-left sub-label" title="Montado a partir do horário de login/logoff da sessão (agente sem os eventos do Windows)"></i>
                        }
                    </td>
                    <td class="mono">
                        @h.ServerName
                        @if (h.Cliente is not null)
                        {
                            <span class="sub-label">(@h.Cliente)</span>
                        }
                    </td>
                    <td>@h.Username</td>
                    <td class="mono">@h.RdsSessionId</td>
                    <td class="mono">@l.TextoOrigem</td>
                    <td class="mono">@l.TextoDuracao</td>
                    <td class="evento-status">
                        <span class="status-dot @CorEvento(l.Tipo)"></span>
                        <strong>@l.Status</strong>
                    </td>
                    <td>@l.TextoDetalhe</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (!carregando)
{
    <p class="dash-note">Nenhum evento encontrado com esses filtros. Os dados aparecem assim que o agente estiver instalado.</p>
}

@code {
    private readonly PeriodoFiltro   periodo = new("1h");
    private readonly FiltroRelatorio filtro  = new();

    private List<SessionHistory> itens = new();
    private ResumoRelatorio resumo = new(0, 0, TimeSpan.Zero, TimeSpan.Zero, 0);
    private bool truncado;
    private bool carregando;
    private List<string> servidores = new();
    private List<string> clientes   = new();
    private List<LinhaEvento> linhas = new();
    private bool incluirSecundarios;
    private readonly Ordenacao ordem = new("data", desc: true);
    private const int LimiteTela = 2000;

    protected override async Task OnInitializedAsync()
    {
        servidores = await RelatorioService.ListarServidoresAsync();
        clientes   = await RelatorioService.ListarClientesAsync();
        await PesquisarAsync();
    }

    private async Task PesquisarAsync()
    {
        if (periodo.Invalido) return;
        filtro.DeLocal  = periodo.DeLocal;
        filtro.AteLocal = periodo.AteLocal;

        carregando = true;
        StateHasChanged();
        (itens, truncado) = await RelatorioService.PesquisarHistoricoAsync(filtro);
        resumo = RelatorioService.Resumir(itens);
        MontarLinhas();
        carregando = false;
    }

    private async Task LimparAsync()
    {
        filtro.Servidor = filtro.Cliente = filtro.Usuario = filtro.Situacao = null;
        periodo.Aplicar("1h");
        await PesquisarAsync();
    }

    private async Task EnterAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await PesquisarAsync();
    }

    private void MontarLinhas()
    {
        linhas = RelatorioService.Eventos(itens, Horario.ParaUtc(periodo.DeLocal), Horario.ParaUtc(periodo.AteLocal), incluirSecundarios);
        linhas = ordem.Aplicar(linhas, RelatorioOrdenacao.Colunas).ToList();
    }

    private static string CorEvento(SessionEventType t) => t switch
    {
        SessionEventType.Logon or SessionEventType.Reconexao => "active",
        SessionEventType.Desconexao                          => "disconnected",
        SessionEventType.Logoff                              => "idle",
        _                                                    => "",
    };

    private string Url(string arquivo)
    {
        var q = new List<string>();
        void Add(string k, string? v) { if (!string.IsNullOrWhiteSpace(v)) q.Add($"{k}={Uri.EscapeDataString(v)}"); }
        Add("de",       PeriodoFiltro.ParaUrl(periodo.DeLocal));
        Add("ate",      PeriodoFiltro.ParaUrl(periodo.AteLocal));
        Add("servidor", filtro.Servidor);
        Add("cliente",  filtro.Cliente);
        Add("usuario",  filtro.Usuario);
        Add("situacao", filtro.Situacao);
        if (incluirSecundarios) Add("secundarios", "1");
        Add("ordenar", ordem.ParaUrl());
        return $"/api/relatorios/{arquivo}" + (q.Count > 0 ? "?" + string.Join("&", q) : "");
    }

    private static string Horas(TimeSpan d) => $"{(int)d.TotalHours}h {d.Minutes:D2}m";

    /// <summary>Tempo curto (quedas de conexão): segundos quando for menos de uma hora.</summary>
    private static string Curta(TimeSpan d) => d.TotalHours >= 1 ? Horas(d) : $"{(int)d.TotalMinutes}m {d.Seconds:D2}s";

}
