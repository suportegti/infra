@page "/login"
@inject IConfiguracaoService Configuracao

<PageTitle>Entrar · RDSManager</PageTitle>

<div class="login-screen">
    <button type="button" class="theme-toggle login-theme-toggle" onclick="toggleTheme()" title="Alternar tema claro/escuro" aria-label="Alternar tema">
        <i class="fa-solid fa-sun theme-icon-light"></i>
        <i class="fa-solid fa-moon theme-icon-dark"></i>
    </button>

    <div class="login-card">
        <div class="login-mark">
            <i class="fa-solid fa-server"></i>
        </div>

        <h1>Bem-vindo!</h1>
        <p class="login-subtitle">Acesse sua conta para continuar</p>

        @if (Erro == "1")
        {
            <div class="login-alert" role="alert">
                Usuário ou senha inválidos.
            </div>
        }
        else if (Erro == "bloqueio")
        {
            <div class="login-alert" role="alert">
                Muitas tentativas sem sucesso. Conta bloqueada temporariamente@(MinutosBloqueio is { } m ? $" por {m} minuto(s)" : ""). Tente novamente mais tarde.
            </div>
        }
        else if (Erro == "limite")
        {
            <div class="login-alert" role="alert">
                Muitas tentativas de login a partir deste endereço. Aguarde um minuto e tente de novo.
            </div>
        }
        else if (Erro == "usar-m365")
        {
            <div class="login-alert login-alert-info" role="alert">
                Esta conta entra com o Microsoft 365. Use o botão <strong>Entrar com Microsoft 365</strong>.
            </div>
        }
        else if (Erro == "m365-usuario")
        {
            <div class="login-alert" role="alert">
                Sua conta Microsoft foi aceita, mas não há usuário do RDSManager com esse e-mail configurado para entrar com o Microsoft 365. Fale com a equipe de TI.
            </div>
        }
        else if (Erro == "m365")
        {
            <div class="login-alert" role="alert">
                Não foi possível concluir o login com o Microsoft 365. Tente de novo ou fale com a equipe de TI.
            </div>
        }
        else if (Erro == "m365-desligado")
        {
            <div class="login-alert" role="alert">
                O login com Microsoft 365 não está habilitado neste portal.
            </div>
        }

        <form method="post" action="/api/auth/login">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <label class="field" for="username">
                <i class="fa-solid fa-user"></i>
                <input id="username" name="username" type="text" placeholder="Usuário" autocomplete="username" required autofocus />
            </label>

            <label class="field field-senha" for="password">
                <i class="fa-solid fa-lock"></i>
                <input id="password" name="password" type="password" placeholder="Senha" autocomplete="current-password" required />
                <button type="button" class="olho-senha" tabindex="-1" aria-label="Mostrar senha (mantenha pressionado)" title="Mantenha pressionado para ver a senha"><i class="fa-solid fa-eye"></i></button>
            </label>

            <div class="login-options">
                <label class="remember-me">
                    <input type="checkbox" name="lembrarMe" />
                    Lembrar-me
                </label>
                <a class="forgot-password" href="recuperar-senha">
                    Esqueci minha senha
                </a>
            </div>

            <button type="submit" class="btn-entrar">ENTRAR</button>
        </form>

        @if (m365Habilitado)
        {
            <div class="login-separador"><span>ou</span></div>
            <a class="btn-microsoft" href="/api/auth/m365">
                <svg viewBox="0 0 21 21" width="18" height="18" aria-hidden="true">
                    <rect x="1" y="1" width="9" height="9" fill="#f25022" /><rect x="11" y="1" width="9" height="9" fill="#7fba00" />
                    <rect x="1" y="11" width="9" height="9" fill="#00a4ef" /><rect x="11" y="11" width="9" height="9" fill="#ffb900" />
                </svg>
                Entrar com Microsoft 365
            </a>
        }

        <p class="login-hint">
            <a href="alterar-senha">Alterar minha senha</a>
        </p>
    </div>

    <div class="login-footer">
        <i class="fa-solid fa-server"></i>
        <span>Powered by <strong>RDSManager</strong></span>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    [SupplyParameterFromQuery(Name = "min")]
    private int? MinutosBloqueio { get; set; }

    private bool m365Habilitado;

    protected override async Task OnInitializedAsync()
    {
        var m = await Configuracao.M365Async();
        m365Habilitado = m.LoginHabilitado && m.Configurado;
    }
}
