@page "/usuarios"
@attribute [Authorize(Policy = Permissoes.UsuariosGerenciar)]
@inject IUserService UserService
@inject IPerfilService PerfilService
@inject PresencaService Presenca
@inject IConfiguracaoService Configuracao
@inject IAvisoNovoUsuarioService AvisoNovoUsuario

<PageTitle>Usuários do Sistema · RDSManager</PageTitle>

<div class="dash-header">
    <h1>Usuários do sistema</h1>
    <p>Inclua, edite ou desabilite usuários com acesso ao RDSManager. Usuários não são excluídos, só desabilitados, para preservar o histórico de auditoria.</p>
</div>

@if (Sucesso == "criado")
{
    @if (EmailStatus == "falhou-senha")
    {
        <div class="login-alert" role="alert">
            Usuário <strong>@UsuarioCriado</strong> criado, mas o e-mail com a senha temporária <strong>não foi enviado</strong>.
            Edite o usuário e defina uma senha (com "Exigir troca" marcado), ou confira <a href="emails-enviados">E-mails enviados</a> para ver o motivo.
        </div>
    }
    else
    {
        <div class="login-alert login-alert-success" role="alert">
            Usuário criado com sucesso.
            @if (EmailStatus == "enviado") { <span>E-mail de boas-vindas enviado.</span> }
            else if (EmailStatus == "falhou") { <span>O e-mail de boas-vindas não foi enviado — veja o motivo em <a href="emails-enviados">E-mails enviados</a>.</span> }
        </div>
    }
}
else if (Sucesso == "editado")
{
    <div class="login-alert login-alert-success" role="alert">Usuário atualizado com sucesso.</div>
}
else if (Sucesso == "status")
{
    <div class="login-alert login-alert-success" role="alert">Status do usuário atualizado.</div>
}
else if (Sucesso == "desbloqueado")
{
    <div class="login-alert login-alert-success" role="alert">Bloqueio removido. O usuário já pode entrar com a senha atual.</div>
}
else if (Erro == "usuario-existe")
{
    <div class="login-alert" role="alert">Já existe um usuário com esse nome de login.</div>
}
else if (Erro == "senha-fraca")
{
    <div class="login-alert" role="alert">A senha inicial deve ter pelo menos 8 caracteres.</div>
}
else if (Erro == "dados-invalidos")
{
    <div class="login-alert" role="alert">Preencha todos os campos obrigatórios corretamente.</div>
}
else if (Erro == "nao-encontrado")
{
    <div class="login-alert" role="alert">Usuário não encontrado.</div>
}
else if (Erro == "email-existe")
{
    <div class="login-alert" role="alert">Outro usuário já usa esse e-mail.</div>
}
else if (Erro == "email-m365")
{
    <div class="login-alert" role="alert">Contas Microsoft 365 precisam de um e-mail válido (é o login da pessoa na Microsoft).</div>
}
else if (Erro == "email-senha-gerada")
{
    <div class="login-alert" role="alert">Para gerar a senha temporária e enviá-la por e-mail, informe o e-mail do usuário.</div>
}
else if (Erro == "email-desligado")
{
    <div class="login-alert" role="alert">O envio de e-mail ao criar usuários está desligado ou não configurado (Configurações &gt; E-mail). Informe uma senha inicial.</div>
}
else if (Erro == "ultimo-admin")
{
    <div class="login-alert" role="alert">Não é possível desabilitar o último administrador ativo do sistema.</div>
}

<details class="form-card">
    <summary>
        <span><i class="fa-solid fa-user-plus"></i> Novo usuário</span>
        <i class="fa-solid fa-chevron-down chevron"></i>
    </summary>
    <form method="post" action="/api/usuarios/criar" class="form-usuario" data-tipo="Local" data-gerar="@(avisoAtivo ? "1" : "0")">
        <div class="form-grid">
            <label class="field">
                <i class="fa-solid fa-user"></i>
                <input name="username" placeholder="Usuário (login)" required />
            </label>
            <label class="field">
                <i class="fa-solid fa-id-badge"></i>
                <input name="displayName" placeholder="Nome de exibição" required />
            </label>
            <label class="field">
                <i class="fa-solid fa-user-shield"></i>
                <select name="perfilId" required>
                    @foreach (var p in Perfis)
                    {
                        <option value="@p.Id" selected="@(p.Nome == Permissoes.PerfilOperador)">@p.Nome</option>
                    }
                </select>
            </label>
            <label class="field">
                <i class="fa-solid fa-envelope"></i>
                <input name="email" type="email" maxlength="200" placeholder="E-mail (recuperação de senha / login Microsoft 365)" />
            </label>
            <label class="field">
                <i class="fa-solid fa-right-to-bracket"></i>
                <select name="tipoAutenticacao" class="tipo-autenticacao" aria-label="Como o usuário entra">
                    <option value="Local">Login local (usuário e senha do portal)</option>
                    <option value="Microsoft365">Microsoft 365 (conta da empresa, pelo e-mail)</option>
                </select>
            </label>
            <label class="field field-senha so-local so-senha-manual">
                <i class="fa-solid fa-key"></i>
                <input name="senhaInicial" type="password" placeholder="Senha inicial (mín. 8 caracteres)" minlength="8" />
                <button type="button" class="olho-senha" tabindex="-1" aria-label="Mostrar senha (mantenha pressionado)" title="Mantenha pressionado para ver a senha"><i class="fa-solid fa-eye"></i></button>
            </label>
        </div>
        <div class="so-local form-checks">
            <label class="toolbar-check" title="@(avisoAtivo ? "O portal cria uma senha temporária e envia por e-mail com o link do portal; a troca é obrigatória no primeiro acesso." : "Configure o envio de e-mail em Configurações > E-mail para usar esta opção.")">
                <input type="checkbox" name="gerarSenha" value="true" class="gerar-senha" checked="@avisoAtivo" disabled="@(!avisoAtivo)" />
                Gerar senha temporária e enviar por e-mail
            </label>
            <label class="toolbar-check">
                <input type="checkbox" name="exigirTroca" value="true" checked />
                Exigir troca de senha no primeiro login
            </label>
            <label class="toolbar-check">
                <input type="checkbox" name="senhaExpira" value="true" />
                Senha expira a cada @validadeDias dias
            </label>
        </div>
        <p class="so-m365 dash-note" style="margin:.75rem 0 0;">
            A pessoa entra pelo botão <strong>Entrar com Microsoft 365</strong> usando a conta da empresa com este e-mail.
            Senha, troca e expiração seguem as regras do Microsoft 365.
        </p>
        <div class="form-actions">
            <button type="submit" class="btn-pill primary"><i class="fa-solid fa-plus"></i> Criar usuário</button>
        </div>
    </form>
</details>

<section class="online-panel" aria-labelledby="online-titulo">
    <h2 id="online-titulo" class="relatorio-titulo">
        <span class="status-dot active"></span> Conectados agora no portal
        <span class="sub-label">@Online.Count usuário(s) · horário de Brasília</span>
    </h2>
    @if (Online.Count == 0)
    {
        <p class="dash-note">Ninguém conectado no momento.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Usuário</th>
                    <th>Nome</th>
                    <th>IP</th>
                    <th>Entrou às</th>
                    <th>Última atividade</th>
                    <th>Telas abertas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Online)
                {
                    <tr>
                        <td class="mono">@o.Username</td>
                        <td>@o.Nome</td>
                        <td class="mono">@(o.Ip ?? "—")</td>
                        <td class="mono">@Horario.Fmt(o.EntrouEm, "dd/MM HH:mm")</td>
                        <td class="mono">@Horario.Fmt(o.UltimaAtividade, "HH:mm:ss")</td>
                        <td class="mono">@(o.TelasAbertas == 0 ? "—" : o.TelasAbertas.ToString())</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <p class="dash-note">
        Conta como conectado quem está com uma tela aberta ou usou o portal nos últimos @((int)PresencaService.JanelaInatividade.TotalMinutes) minutos.
        A lista recomeça vazia se o serviço do portal for reiniciado.
    </p>
</section>

<h2 class="relatorio-titulo"><i class="fa-solid fa-users"></i> Todos os usuários</h2>

<table class="data-table">
    <thead>
        <tr>
            <th>Usuário</th>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Perfil</th>
            <th>Status</th>
            <th>Último login <span class="sub-label">(Brasília)</span></th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in ListaUsuarios)
        {
            <tr>
                <td class="mono">
                    @usuario.Username
                    @if (Presenca.EstaOnline(usuario.Username))
                    {
                        <span class="badge bg-success" title="Conectado ao portal agora"><span class="status-dot active"></span> online</span>
                    }
                </td>
                <td>@usuario.DisplayName</td>
                <td class="mono">@(usuario.Email ?? "—")</td>
                <td><span class="badge bg-secondary">@(usuario.Perfil?.Nome ?? "Sem perfil")</span></td>
                <td>
                    <span class="status-dot @(usuario.Ativo ? "active" : "disconnected")"></span>
                    @(usuario.Ativo ? "Ativo" : "Desabilitado")
                    @if (Bloqueado(usuario))
                    {
                        <span class="badge bg-warning text-dark" title="Bloqueado por tentativas de login">
                            <i class="fa-solid fa-lock"></i> Bloqueado até @Horario.Fmt(usuario.LockoutEnd!.Value, "HH:mm")
                        </span>
                    }
                    @if (usuario.TipoAutenticacao == TipoAutenticacao.Microsoft365)
                    {
                        <span class="badge bg-primary" title="Entra com a conta Microsoft 365 do e-mail cadastrado">Microsoft 365</span>
                    }
                    else if (usuario.SenhaVenceEm(validadeDias) is { } vence)
                    {
                        var dias = (int)Math.Ceiling((vence - DateTime.UtcNow).TotalDays);
                        <span class="badge @(dias <= 0 ? "bg-danger" : dias <= 7 ? "bg-warning text-dark" : "bg-secondary")"
                              title="Senha vence em @Horario.Fmt(vence, "dd/MM/yyyy")">
                            <i class="fa-solid fa-hourglass-half"></i> @(dias <= 0 ? "Senha vencida" : $"Senha vence em {dias} dia(s)")
                        </span>
                    }
                    @if (usuario.TrocarSenhaNoProximoLogin)
                    {
                        <span class="badge bg-info text-dark" title="O usuário vai definir uma nova senha no próximo login">
                            <i class="fa-solid fa-key"></i> Troca de senha pendente
                        </span>
                    }
                </td>
                <td class="mono">@Horario.Fmt(usuario.UltimoLogin)</td>
                <td class="acoes">
                    <a class="btn-pill" href="@($"usuarios/editar/{usuario.Id}")"><i class="fa-solid fa-pen"></i> Editar</a>
                    <a class="btn-pill" href="@($"usuarios/{usuario.Id}/acessos")" title="Todos os logins, falhas, saídas e trocas de senha deste usuário">
                        <i class="fa-solid fa-clock-rotate-left"></i> Acessos
                    </a>
                    @if (Bloqueado(usuario))
                    {
                        <form method="post" action="/api/usuarios/desbloquear" style="display:inline">
                            <input type="hidden" name="id" value="@usuario.Id" />
                            <button type="submit" class="btn-pill success"><i class="fa-solid fa-unlock"></i> Desbloquear</button>
                        </form>
                    }
                    <form method="post" action="/api/usuarios/alternar-ativo" style="display:inline">
                        <input type="hidden" name="id" value="@usuario.Id" />
                        <button type="submit" class="btn-pill @(usuario.Ativo ? "danger" : "success")">
                            @if (usuario.Ativo)
                            {
                                <span><i class="fa-solid fa-user-slash"></i> Desabilitar</span>
                            }
                            else
                            {
                                <span><i class="fa-solid fa-user-check"></i> Habilitar</span>
                            }
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="dash-note">
    As permissões de cada perfil são configuradas em <a href="perfis-usuarios">Perfis de usuários</a>.
    Alterações de perfil valem em até 30 segundos, sem o usuário precisar sair.
</p>

@code {
    [SupplyParameterFromQuery(Name = "sucesso")]
    private string? Sucesso { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    private List<AppUser> ListaUsuarios { get; set; } = new();
    private List<UsuarioOnline> Online { get; set; } = new();
    private int validadeDias = 90;
    private bool avisoAtivo;

    [SupplyParameterFromQuery(Name = "email")] private string? EmailStatus { get; set; }
    [SupplyParameterFromQuery(Name = "u")]     private string? UsuarioCriado { get; set; }
    private List<RDSMonitor.Web.Data.Entities.Perfil> Perfis { get; set; } = new();

    private static bool Bloqueado(AppUser u) => u.LockoutEnd is { } fim && fim > DateTime.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        ListaUsuarios = await UserService.ListarAsync();
        Online        = Presenca.Online();
        validadeDias  = (await Configuracao.PoliticaSenhaAsync()).ValidadeDias;
        Perfis        = await PerfilService.ListarParaSelecaoAsync();
        avisoAtivo    = await AvisoNovoUsuario.AtivoAsync();
    }
}
