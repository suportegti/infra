@page "/usuarios"
@attribute [Authorize(Policy = Permissoes.UsuariosGerenciar)]
@inject IUserService UserService
@inject IPerfilService PerfilService

<PageTitle>Usuários do Sistema · RDSManager</PageTitle>

<div class="dash-header">
    <h1>Usuários do sistema</h1>
    <p>Inclua, edite ou desabilite usuários com acesso ao RDSManager. Usuários não são excluídos, só desabilitados, para preservar o histórico de auditoria.</p>
</div>

@if (Sucesso == "criado")
{
    <div class="login-alert login-alert-success" role="alert">Usuário criado com sucesso.</div>
}
else if (Sucesso == "editado")
{
    <div class="login-alert login-alert-success" role="alert">Usuário atualizado com sucesso.</div>
}
else if (Sucesso == "status")
{
    <div class="login-alert login-alert-success" role="alert">Status do usuário atualizado.</div>
}
else if (Sucesso == "desbloqueado")
{
    <div class="login-alert login-alert-success" role="alert">Bloqueio removido. O usuário já pode entrar com a senha atual.</div>
}
else if (Erro == "usuario-existe")
{
    <div class="login-alert" role="alert">Já existe um usuário com esse nome de login.</div>
}
else if (Erro == "senha-fraca")
{
    <div class="login-alert" role="alert">A senha inicial deve ter pelo menos 8 caracteres.</div>
}
else if (Erro == "dados-invalidos")
{
    <div class="login-alert" role="alert">Preencha todos os campos obrigatórios corretamente.</div>
}
else if (Erro == "nao-encontrado")
{
    <div class="login-alert" role="alert">Usuário não encontrado.</div>
}
else if (Erro == "ultimo-admin")
{
    <div class="login-alert" role="alert">Não é possível desabilitar o último administrador ativo do sistema.</div>
}

<details class="form-card">
    <summary>
        <span><i class="fa-solid fa-user-plus"></i> Novo usuário</span>
        <i class="fa-solid fa-chevron-down chevron"></i>
    </summary>
    <form method="post" action="/api/usuarios/criar">
        <div class="form-grid">
            <label class="field">
                <i class="fa-solid fa-user"></i>
                <input name="username" placeholder="Usuário (login)" required />
            </label>
            <label class="field">
                <i class="fa-solid fa-id-badge"></i>
                <input name="displayName" placeholder="Nome de exibição" required />
            </label>
            <label class="field">
                <i class="fa-solid fa-user-shield"></i>
                <select name="perfilId" required>
                    @foreach (var p in Perfis)
                    {
                        <option value="@p.Id" selected="@(p.Nome == Permissoes.PerfilOperador)">@p.Nome</option>
                    }
                </select>
            </label>
            <label class="field">
                <i class="fa-solid fa-key"></i>
                <input name="senhaInicial" type="password" placeholder="Senha inicial (mín. 8 caracteres)" minlength="8" required />
            </label>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-pill primary"><i class="fa-solid fa-plus"></i> Criar usuário</button>
        </div>
    </form>
</details>

<table class="data-table">
    <thead>
        <tr>
            <th>Usuário</th>
            <th>Nome</th>
            <th>Perfil</th>
            <th>Status</th>
            <th>Último login</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in ListaUsuarios)
        {
            <tr>
                <td class="mono">@usuario.Username</td>
                <td>@usuario.DisplayName</td>
                <td><span class="badge bg-secondary">@(usuario.Perfil?.Nome ?? "Sem perfil")</span></td>
                <td>
                    <span class="status-dot @(usuario.Ativo ? "active" : "disconnected")"></span>
                    @(usuario.Ativo ? "Ativo" : "Desabilitado")
                    @if (Bloqueado(usuario))
                    {
                        <span class="badge bg-warning text-dark" title="Bloqueado por tentativas de login">
                            <i class="fa-solid fa-lock"></i> Bloqueado até @usuario.LockoutEnd!.Value.ToLocalTime().ToString("HH:mm")
                        </span>
                    }
                </td>
                <td class="mono">@(usuario.UltimoLogin?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                <td class="acoes">
                    <a class="btn-pill" href="@($"usuarios/editar/{usuario.Id}")"><i class="fa-solid fa-pen"></i> Editar</a>
                    @if (Bloqueado(usuario))
                    {
                        <form method="post" action="/api/usuarios/desbloquear" style="display:inline">
                            <input type="hidden" name="id" value="@usuario.Id" />
                            <button type="submit" class="btn-pill success"><i class="fa-solid fa-unlock"></i> Desbloquear</button>
                        </form>
                    }
                    <form method="post" action="/api/usuarios/alternar-ativo" style="display:inline">
                        <input type="hidden" name="id" value="@usuario.Id" />
                        <button type="submit" class="btn-pill @(usuario.Ativo ? "danger" : "success")">
                            @if (usuario.Ativo)
                            {
                                <span><i class="fa-solid fa-user-slash"></i> Desabilitar</span>
                            }
                            else
                            {
                                <span><i class="fa-solid fa-user-check"></i> Habilitar</span>
                            }
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="dash-note">
    As permissões de cada perfil são configuradas em <a href="perfis-usuarios">Perfis de usuários</a>.
    Alterações de perfil valem em até 30 segundos, sem o usuário precisar sair.
</p>

@code {
    [SupplyParameterFromQuery(Name = "sucesso")]
    private string? Sucesso { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    private List<AppUser> ListaUsuarios { get; set; } = new();
    private List<RDSMonitor.Web.Data.Entities.Perfil> Perfis { get; set; } = new();

    private static bool Bloqueado(AppUser u) => u.LockoutEnd is { } fim && fim > DateTime.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        ListaUsuarios = await UserService.ListarAsync();
        Perfis        = await PerfilService.ListarParaSelecaoAsync();
    }
}
