@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IServerService ServerService
@implements IDisposable

<PageTitle>Dashboard · RDSManager</PageTitle>

<div class="dash-header">
    <h1>Dashboard</h1>
    <p>Visão geral dos servidores RDS monitorados.</p>
</div>

<section class="summary-grid">
    <div class="summary-card">
        <div class="summary-icon icon-blue"><i class="fa-solid fa-hard-drive"></i></div>
        <div class="summary-body">
            <span class="summary-title">Servidores online</span>
            <span class="summary-value">@servidores.Count(s => s.IsOnline)</span>
            <a class="summary-link" href="servidores">Ver todos <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
    <div class="summary-card">
        <div class="summary-icon icon-green"><i class="fa-solid fa-desktop"></i></div>
        <div class="summary-body">
            <span class="summary-title">Sessões ativas</span>
            <span class="summary-value">@servidores.Sum(s => s.Sessions.Count)</span>
            <a class="summary-link" href="sessoes">Ver todas <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
    <div class="summary-card">
        <div class="summary-icon icon-amber"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="summary-body">
            <span class="summary-title">Servidores em alerta</span>
            <span class="summary-value">@servidores.Count(s => s.IsOnline && s.CpuPercent > 80)</span>
            <a class="summary-link" href="servidores">Ver todos <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
</section>

<section class="quick-actions">
    <h2><i class="fa-solid fa-bolt"></i> Ações Rápidas</h2>
    <div class="quick-actions-row">
        <a class="btn-pill primary" href="sessoes">
            <i class="fa-solid fa-desktop"></i> Ver Sessões
        </a>
        <a class="btn-pill" href="servidores">
            <i class="fa-solid fa-hard-drive"></i> Ver Servidores
        </a>
        <button class="btn-pill" disabled title="Disponível em uma próxima etapa">
            <i class="fa-solid fa-bell"></i> Configurar Alertas
        </button>
    </div>
</section>

<section class="server-grid">
    @foreach (var servidor in servidores)
    {
        var isAlerta = servidor.IsOnline && servidor.CpuPercent > 80;
        <a class="server-card @(isAlerta ? "is-alert" : "")" href="sessoes">
            <div class="server-card-top">
                <span class="status-dot @(servidor.IsOnline ? (isAlerta ? "idle" : "active") : "disconnected")"></span>
                <span class="server-name">@(servidor.DisplayName ?? servidor.Name)</span>
            </div>
            @if (servidor.IsOnline)
            {
                <span class="server-count">@servidor.Sessions.Count</span>
                <span class="server-label">usuários conectados</span>
                <span class="server-label" style="font-size:.75rem;margin-top:.25rem;">
                    CPU @servidor.CpuPercent.ToString("0.#")% · RAM @servidor.MemoryUsedGb.ToString("0.##") GB
                </span>
            }
            else
            {
                <span class="server-count" style="font-size:1rem;color:var(--text-muted)">Offline</span>
                <span class="server-label">aguardando agente</span>
            }
        </a>
    }
</section>

@if (!servidores.Any(s => s.IsOnline))
{
    <p class="dash-note">
        Nenhum agente conectado ainda. Instale o <strong>RDSMonitor.Agent</strong> em cada servidor
        RDS e ele começará a enviar dados automaticamente.
    </p>
}

@code {
    private List<Server> servidores = new();
    private System.Timers.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();

        _timer = new System.Timers.Timer(30_000);
        _timer.Elapsed += async (_, _) => await InvokeAsync(async () =>
        {
            await CarregarAsync();
            StateHasChanged();
        });
        _timer.Start();
    }

    private async Task CarregarAsync()
        => servidores = await ServerService.GetAllWithSessionsAsync();

    public void Dispose() => _timer?.Dispose();
}
